# 告訴 EditorConfig：
# 從這個檔案開始往下，不需要再尋找上一層的 .editorconfig。
root = true


# ==========================================
# 所有檔案的基本設定
# ==========================================

[*]

# 使用 UTF-8。
charset = utf-8

# 每個檔案最後保留換行。
insert_final_newline = true

# 自動移除行尾多餘空白。
trim_trailing_whitespace = true


# ==========================================
# C# 檔案
# ==========================================

[*.cs]

# C# 慣例使用 4 個空白縮排。
indent_style = space
indent_size = 4


# ==========================================
# Razor / HTML / CSS / JavaScript
# ==========================================

[*.{cshtml,html,css,js}]

# 這個專案統一使用 4 個空白。
indent_style = space
indent_size = 4


# ==========================================
# JSON
# ==========================================

[*.json]

indent_style = space
indent_size = 2