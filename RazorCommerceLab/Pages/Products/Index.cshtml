@page
@model RazorCommerceLab.Pages.Products.IndexModel

@{
    ViewData["Title"] = "商品";
}


<header class="page-header">

    <h1>
        商品
    </h1>

    <p>
        搜尋、分類並瀏覽所有商品。
    </p>

</header>


@* ==========================================
   Search / Filter
   ========================================== *@

<form method="get" class="product-filter">

    <div class="form-field">

        <label asp-for="Keyword">
            關鍵字
        </label>

        <input asp-for="Keyword" type="search" placeholder="搜尋商品名稱、描述或品牌" />

    </div>


    <div class="form-field">

        <label asp-for="Category">
            分類
        </label>

        <select asp-for="Category">

            <option value="">
                全部分類
            </option>

            @foreach (var category in Model.Categories)
            {
                <option value="@category">
                    @category
                </option>
            }

        </select>

    </div>


    <div class="product-filter__actions">

        <button type="submit" class="btn btn-primary">
            搜尋
        </button>

        @*
            不帶 query string 回到 /Products，
            等於清除搜尋條件。
        *@
        <a asp-page="/Products/Index" class="btn btn-secondary">
            清除
        </a>

    </div>

</form>


@* ==========================================
   Result summary
   ========================================== *@

<div class="result-summary">

    <p>
        共找到
        <strong>@Model.TotalItems</strong>
        筆商品
    </p>

    @if (Model.TotalPages > 0)
    {
        <p>
            第 @Model.CurrentPage / @Model.TotalPages 頁
        </p>
    }

</div>


@* ==========================================
   Products
   ========================================== *@

@if (Model.Products.Count == 0)
{
    <div class="empty-state">

        <h2>
            找不到商品
        </h2>

        <p>
            請調整搜尋關鍵字或分類條件。
        </p>

    </div>
}
else
{
    <div class="product-grid">

        @foreach (var product in Model.Products)
        {
            <partial name="_ProductCard" model="product" />
        }

    </div>
}


@* ==========================================
   Pagination
   ========================================== *@

@if (Model.TotalPages > 1)
{
    <nav class="pagination" aria-label="商品分頁">


        @if (Model.HasPreviousPage)
        {
            /*
                分頁時要把 Keyword / Category 保留下來。

                否則：

                搜尋 beauty
                ↓
                點第二頁
                ↓
                搜尋條件突然消失
            */
            <a class="pagination__link" asp-page="/Products/Index" asp-route-keyword="@Model.Keyword"
               asp-route-category="@Model.Category" asp-route-pageNumber="@(Model.CurrentPage - 1)">
                上一頁
            </a>
        }


        <span class="pagination__current">
            @Model.CurrentPage / @Model.TotalPages
        </span>


        @if (Model.HasNextPage)
        {
            <a class="pagination__link" asp-page="/Products/Index" asp-route-keyword="@Model.Keyword"
               asp-route-category="@Model.Category" asp-route-pageNumber="@(Model.CurrentPage + 1)">
                下一頁
            </a>
        }

    </nav>
}
