@page
@model RazorCommerceLab.Pages.ErrorModel

@{
    ViewData["Title"] = "500 - 伺服器錯誤";
}


<section class="error-page">

    <div class="error-page__content">


        @* ======================================
           Status Code
           ====================================== *@

        <p class="error-page__code">
            500
        </p>


        <h1>
            伺服器發生錯誤
        </h1>


        <p class="error-page__description">

            處理 Request 時發生未預期的錯誤。
            請稍後重新嘗試。

        </p>


        @* ======================================
           Original Path
           ====================================== *@

        @if (!string.IsNullOrWhiteSpace(
                Model.OriginalPath))
        {
            <p class="error-page__path">

                發生錯誤的頁面：

                <code>
                    @Model.OriginalPath
                </code>

            </p>
        }


        @* ======================================
           Request ID
           ====================================== *@

        @if (Model.ShowRequestId)
        {
            <p class="error-page__request-id">

                Request ID：

                <code>
                    @Model.RequestId
                </code>

            </p>
        }


        <div class="error-page__actions">

            <a asp-page="/Index" class="btn btn-primary">

                返回首頁

            </a>


            <a asp-page="/Products/Index" class="btn btn-secondary">

                瀏覽商品

            </a>

        </div>

    </div>

</section>
